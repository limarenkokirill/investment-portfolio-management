
managed implementation in class zbp_inv_r_security unique;
strict ( 2 );
with draft;

define behavior for ZINV_R_SECURITY alias Security
persistent table zinv_security
draft table zinv_security_d
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  internal delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;



  field ( numbering : managed, readonly ) SecurityUUID;
  field ( mandatory : create ) Ticker, OpenDate;
  field ( mandatory : create, readonly : update )
  ISIN,
  SecurityName,
  Issuer,
  SecurityType,
  Currency;
  field ( readonly )
  Status,
  CloseDate,
  CreatedBy,
  CreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  determination SetInitialStatus on modify {create;}
  determination NormalizeIdentifiers on modify { create; field Ticker; }
  validation ValidateISIN on save  { create; field isin; }
  validation ValidateOpenDate on save  { create; field OpenDate; }
  validation ValidateSecurityType on save { create; field SecurityType; }
  validation validatesecurityTicker on save { create; field Ticker; }
  action ( features : instance,
    authorization : update ) delist result [1] $self;
  action ( features : instance ) changeTicker result [1] $self;



  draft determine action Prepare
   {
      validation validatesecurityTicker;
      validation ValidateSecurityType;
      validation ValidateOpenDate;
      validation ValidateISIN;
   }

  mapping for zinv_security
  {
    SecurityUUID         = securityuuid;
    ISIN                 = isin;
    Ticker               = ticker;
    SecurityName         = securityname;
    Issuer               = issuer;
    OpenDate             = opendate;
    CloseDate            = closedate;
    SecurityType         = securitytype;
    Currency             = currency;
    Status               = status;
    CreatedBy            = created_by;
    CreatedAt            = created_at;
    LocalLastChangedBy   = local_last_changed_by;
    LocalLastChangedAt   = local_last_changed_at;
    LastChangedAt        = last_changed_at;
  }

}

define own authorization context
{
'ZINV_SEC';
 }